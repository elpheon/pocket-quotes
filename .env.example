# ---------------------------------------------------------------
# Google AdMob ad unit IDs
# ---------------------------------------------------------------
# These are the *ad unit* IDs (the ones with a "/" in them).
# The *app* IDs (with a "~") are not set here — they live in the native
# projects:
#   iOS      ios/App/App/Info.plist          -> GADApplicationIdentifier
#   Android  android/app/src/main/AndroidManifest.xml
#            -> com.google.android.gms.ads.APPLICATION_ID
#
# To test with Google's sample inventory instead of live ads, swap in the
# test unit IDs documented at
# https://developers.google.com/admob/ios/test-ads
# ---------------------------------------------------------------

VITE_ADMOB_BANNER_AD_UNIT_ID_IOS=
VITE_ADMOB_BANNER_AD_UNIT_ID_ANDROID=
VITE_ADMOB_INTERSTITIAL_AD_UNIT_ID_IOS=
VITE_ADMOB_INTERSTITIAL_AD_UNIT_ID_ANDROID=

# Optional: force the UMP consent form to appear while testing on a device.
# Leave both blank in production.
# VITE_ADMOB_DEBUG_GEOGRAPHY=EEA
# VITE_ADMOB_TEST_DEVICE_IDS=
